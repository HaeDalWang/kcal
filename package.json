{
  "name": "kcal",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "node -e \"const c=require('child_process');const f=c.execFileSync('git',['ls-files','--cached','--others','--exclude-standard'],{encoding:'utf8'}).split('\\n').filter(p=>{const s=p&&require('fs').lstatSync(p,{throwIfNoEntry:false});return s&&!s.isSymbolicLink()});const r=c.spawnSync(process.execPath,[require.resolve('prettier/bin/prettier.cjs'),'--write','--ignore-unknown',...f],{stdio:'inherit'});process.exit(r.status??1)\"",
    "format:check": "node -e \"const c=require('child_process');const f=c.execFileSync('git',['ls-files','--cached','--others','--exclude-standard'],{encoding:'utf8'}).split('\\n').filter(p=>{const s=p&&require('fs').lstatSync(p,{throwIfNoEntry:false});return s&&!s.isSymbolicLink()});const r=c.spawnSync(process.execPath,[require.resolve('prettier/bin/prettier.cjs'),'--check','--ignore-unknown',...f],{stdio:'inherit'});process.exit(r.status??1)\"",
    "test": "vitest run",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:dev:mcp": "tauri dev --features mcp --config src-tauri/tauri.mcp.conf.json",
    "tauri:build": "tauri build",
    "rust:check": "cd src-tauri && cargo fmt --check && cargo clippy --all-targets -- -D warnings && cargo test",
    "installer:test": "sh install.test.sh",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm installer:test && pnpm rust:check"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tauri-apps/api": "~2.12.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "~1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "~2.12.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "shadcn": "4.22.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
