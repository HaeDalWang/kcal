{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        "default",
        {
          "identifier": "mcp-dev",
          "description": "개발 전용: MCP bridge 권한. pnpm tauri:dev:mcp에서만 이 overlay로 추가된다.",
          "windows": ["popover", "dashboard"],
          "permissions": ["mcp-bridge:default"]
        }
      ]
    }
  }
}
